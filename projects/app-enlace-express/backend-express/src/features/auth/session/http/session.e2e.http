@baseUrl = http://localhost:4000

# The default seeded users are admin/Admin123! and operador/Operador123!.
# Seed users, roles, resources, role assignments and grants before running this tour.

# @name loginOperador
POST {{baseUrl}}/api/sesion/login
Content-Type: application/json

{
  "identifier": "operador",
  "password": "Operador123!"
}

@operatorToken = {{loginOperador.response.body.$.access_token}}

### JWT: profile is available without an RBAC grant
GET {{baseUrl}}/api/sesion/perfil
Authorization: Bearer {{operatorToken}}

### JWT: inspect effective grants (OPERADOR is seeded with none)
GET {{baseUrl}}/api/permisos
Authorization: Bearer {{operatorToken}}

### JWT + RBAC: authenticated operator without this grant receives 403
GET {{baseUrl}}/api/companies
Authorization: Bearer {{operatorToken}}

###
# @name loginAdmin
POST {{baseUrl}}/api/sesion/login
Content-Type: application/json

{
  "identifier": "admin",
  "password": "Admin123!"
}

@adminToken = {{loginAdmin.response.body.$.access_token}}

### JWT + RBAC: ADMIN has the seeded GET /api/companies grant
GET {{baseUrl}}/api/companies
Authorization: Bearer {{adminToken}}

### OPEN: rotate the operator refresh token to obtain a new token pair
# @name refreshOperador
POST {{baseUrl}}/api/sesion/refresh
Content-Type: application/json

{
  "refresh_token": "{{loginOperador.response.body.$.refresh_token}}"
}

### OPEN: logout revokes the newly rotated operator refresh token
POST {{baseUrl}}/api/sesion/logout
Content-Type: application/json

{
  "refresh_token": "{{refreshOperador.response.body.$.refresh_token}}"
}
